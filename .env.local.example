# --- Neon -------------------------------------------------------------------
# Console do Neon > seu projeto > Connection string.
# Use a versao POOLED (o host tem "-pooler"). Cole a string inteira, com o
# ?sslmode=require no final.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Opcional: teto de conexoes simultaneas no pool (padrao 5).
# DATABASE_POOL_MAX=5

# --- Better Auth ------------------------------------------------------------
# Gere com:  openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-32-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Envio do link de acesso (SMTP) -----------------------------------------
# Opcional em desenvolvimento: sem estas variaveis o link aparece no console.
# Gmail: Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=voce@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
SMTP_FROM=voce@gmail.com

# --- Relatorio mensal por e-mail --------------------------------------------
# Usa o SMTP acima. Quem dispara e o agendador da Vercel (vercel.json), que
# manda este segredo no cabecalho Authorization — sem ele a rota recusa tudo.
# So precisa existir na Vercel; em desenvolvimento, use o botao "Enviar agora"
# da aba Resumo. Gere com:  openssl rand -hex 32
# CRON_SECRET=troque-por-um-valor-aleatorio

# Opcional: fuso que define onde o mes comeca (padrao America/Sao_Paulo).
# REPORT_TIMEZONE=America/Sao_Paulo
